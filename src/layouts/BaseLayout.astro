---
import SiteHeader from "../components/SiteHeader.astro";
import { withBase } from "../lib/url";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "每日同步 AI、大模型与多模态领域的论文、顶会文章和技术报告。",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AI Research Signal RSS"
      href={withBase("feed.xml")}
    />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="page-grain" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <span>RESEARCH / SIGNAL</span>
        <p>AI 研究元数据日报，自动同步，持续更新。</p>
      </div>
      <div class="footer-links">
        <a href={withBase("archive/")}>全部期号</a>
        <a href={withBase("about/")}>方法与数据源</a>
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
      <p class="footer-legal">
        论文标题、摘要和商标归原作者及出版机构所有；本站提供元数据聚合与原文链接。
      </p>
    </footer>
    <script>
      const header = document.querySelector("[data-site-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
