---
import type { CollectionEntry } from "astro:content";
import { formatIssueDate, withBase } from "../lib/url";

interface Props {
  post: CollectionEntry<"posts">;
  index: number;
}

const { post, index } = Astro.props;
const issueDate = formatIssueDate(post.data.date);
const sourceText = post.data.sources.slice(0, 4).join(" · ");
---

<article class="issue-card" style={`--delay: ${Math.min(index, 8) * 60}ms`}>
  <a class="issue-card-link" href={withBase(`issues/${post.id}/`)} aria-label={`阅读 ${post.data.title}`}>
    <div class="issue-card-top">
      <span class="issue-index">ISSUE / {String(post.data.issue ?? index + 1).padStart(3, "0")}</span>
      <time datetime={post.data.date.toISOString()}>{issueDate}</time>
    </div>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    <div class="issue-card-meta">
      <span>{post.data.total ?? "—"} ITEMS</span>
      <span>{sourceText || "RESEARCH SOURCES"}</span>
      <span class="issue-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

