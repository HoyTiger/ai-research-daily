---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/url";
import { site } from "../../site";

const papers = (
  await getCollection("deepReads", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const statusLabel = {
  queued: "待精读",
  reading: "精读中",
  complete: "已完成",
} as const;
const counts = {
  all: papers.length,
  reading: papers.filter((paper) => paper.data.status === "reading").length,
  complete: papers.filter((paper) => paper.data.status === "complete").length,
};
---

<BaseLayout
  title="精读档案｜AI Research Signal"
  description="收藏有价值的 AI 论文，建立可持续迭代的中文精读档案。"
>
  <section class="deep-read-hero section-shell">
    <div>
      <p class="overline">VALUABLE PAPERS / DEEP READING</p>
      <h1>不只收藏，<br /><em>真正读透。</em></h1>
    </div>
    <div class="deep-read-hero-copy">
      <p>
        在任意日报卡片点击“精读并存档”，系统会建立一份带问题清单的长期档案。
        精读过程中补充方法、证据、局限和可迁移结论，状态与正文都进入版本管理。
      </p>
      <dl>
        <div><dt>{counts.all}</dt><dd>全部档案</dd></div>
        <div><dt>{counts.reading}</dt><dd>精读中</dd></div>
        <div><dt>{counts.complete}</dt><dd>已完成</dd></div>
      </dl>
    </div>
  </section>

  <section class="deep-read-list section-shell" aria-labelledby="deep-read-list-title">
    <header class="section-header">
      <div>
        <p class="overline">READING QUEUE</p>
        <h2 id="deep-read-list-title">精读队列</h2>
      </div>
      <a class="text-link" href={withBase()}>返回日报 <span>→</span></a>
    </header>
    {papers.length ? (
      <div class="deep-read-grid">
        {papers.map((paper, index) => (
          <article class="deep-read-card">
            <header>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span class:list={["deep-status", `deep-status-${paper.data.status}`]}>
                {statusLabel[paper.data.status]}
              </span>
            </header>
            <p class="deep-read-source">{paper.data.source} / {paper.data.venue || "VENUE TBD"}</p>
            <h3>
              <a href={withBase(`deep-reads/${paper.id}/`)}>{paper.data.title}</a>
            </h3>
            <p>{paper.data.authors.slice(0, 4).join("、") || "作者见原文"}</p>
            <footer>
              <a href={withBase(`deep-reads/${paper.id}/`)}>打开精读档案 →</a>
              <a
                class="deep-read-edit"
                href={`${site.githubUrl}/edit/main/src/content/deep-reads/${paper.id}.md`}
                target="_blank"
                rel="noopener noreferrer"
              >
                编辑档案 ↗
              </a>
              {paper.data.paperUrl && (
                <a href={paper.data.paperUrl} target="_blank" rel="noopener noreferrer">原文 ↗</a>
              )}
            </footer>
          </article>
        ))}
      </div>
    ) : (
      <div class="deep-read-empty">
        <p>还没有精读档案。打开任意一期日报，在论文卡片底部点击“精读并存档”。</p>
        <a class="button button-primary" href={withBase("archive/")}>从日报中选择论文 ↗</a>
      </div>
    )}
  </section>
</BaseLayout>
