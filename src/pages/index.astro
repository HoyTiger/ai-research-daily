---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import IssueCard from "../components/IssueCard.astro";
import { formatIssueDate, isoDate, withBase } from "../lib/url";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts[0];
const latestDate = latest ? isoDate(latest.data.date) : "";
let latestIssue: any = null;
if (latestDate) {
  const issueFile = path.join(process.cwd(), "data", "issues", `${latestDate}.json`);
  if (fs.existsSync(issueFile)) {
    latestIssue = JSON.parse(fs.readFileSync(issueFile, "utf8"));
  }
}
const picks = latestIssue?.items?.slice(0, 3) ?? [];
const topics = Array.from(
  new Set(
    (latestIssue?.items ?? []).flatMap((item: any) => item.tags?.slice(0, 1) ?? []),
  ),
).slice(0, 6);
const healthySources =
  latestIssue?.source_health?.filter((source: any) => source.item_count > 0) ?? [];
const issueLabel = latest ? String(latest.data.issue ?? 1).padStart(3, "0") : "000";
const todayLabel = latest ? formatIssueDate(latest.data.date) : "WAITING FOR DATA";
---

<BaseLayout
  title="AI Research Signal｜每日 AI 论文与研究信号"
  description="每天自动同步 AI、大模型、多模态方向的 arXiv 论文、顶会论文、顶刊文章与技术报告。"
>
  <section class="home-hero">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="hero-kicker">
      <span class="live-dot"></span>
      <span>DAILY RESEARCH INTELLIGENCE</span>
      <span>SHANGHAI / UTC+8</span>
    </div>
    <div class="hero-main">
      <div class="hero-copy">
        <p class="hero-eyebrow">AI / LLM / MULTIMODALITY</p>
        <h1>
          把噪声很多的<br />
          研究流，整理成
          <em>每日信号。</em>
        </h1>
        <p class="hero-intro">
          自动追踪 arXiv、顶会、顶刊与一线实验室技术报告。
          去重、归类和排序之后，留出一份可以在十分钟内读完的研究简报。
        </p>
        <div class="hero-actions">
          {latest && (
            <a class="button button-primary" href={withBase(`issues/${latest.id}/`)}>
              阅读最新一期 <span aria-hidden="true">↗</span>
            </a>
          )}
          <a class="text-link" href={withBase("archive/")}>浏览全部归档 <span>→</span></a>
        </div>
      </div>

      <aside class="hero-issue" aria-label="最新一期概览">
        <div class="issue-stamp">
          <span>LATEST ISSUE</span>
          <strong>{issueLabel}</strong>
        </div>
        <time>{todayLabel}</time>
        <div class="signal-orbit" aria-hidden="true">
          <span class="orbit orbit-a"></span>
          <span class="orbit orbit-b"></span>
          <span class="orbit orbit-c"></span>
          <span class="orbit-core"></span>
          <span class="orbit-label orbit-label-a">PAPERS</span>
          <span class="orbit-label orbit-label-b">REPORTS</span>
          <span class="orbit-label orbit-label-c">VENUES</span>
        </div>
        <div class="hero-issue-stats">
          <div>
            <strong>{latestIssue?.items?.length ?? "00"}</strong>
            <span>收录条目</span>
          </div>
          <div>
            <strong>{healthySources.length || "00"}</strong>
            <span>活跃通道</span>
          </div>
          <div>
            <strong>{new Set(picks.map((item: any) => item.source_name)).size || "00"}</strong>
            <span>今日精选源</span>
          </div>
        </div>
      </aside>
    </div>
    <div class="hero-footer">
      <span>SCROLL TO THE SIGNAL</span>
      <span class="hero-rule"></span>
      <span>AUTO-SYNC / 07:17 DAILY</span>
    </div>
  </section>

  <section class="frontpage section-shell" aria-labelledby="today-title">
    <header class="section-header">
      <div>
        <span class="section-number">01</span>
        <p class="overline">TODAY'S FRONT PAGE</p>
        <h2 id="today-title">今日精选</h2>
      </div>
      <p>
        来源与主题兼顾，<br />
        不只看 arXiv 热度。
      </p>
    </header>

    {picks.length ? (
      <div class="frontpage-grid">
        {picks.map((item: any, index: number) => (
          <article class:list={["lead-story", { "lead-story--primary": index === 0 }]}>
            <div class="story-rank">0{index + 1}</div>
            <div class="story-meta">
              <span>{item.venue || item.source_name}</span>
              <span>{item.tags?.[0] || "研究"}</span>
            </div>
            <h3>
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.zh_title || item.title}
              </a>
            </h3>
            {item.zh_title && (
              <p class="story-original-title">{item.title}</p>
            )}
            <p>{item.zh_summary || item.ai_tldr || item.summary?.slice(0, 260) || "打开原文查看研究详情。"}</p>
            <footer>
              <span>{item.authors?.slice(0, 2).join("、") || "作者见原文"}</span>
              <span aria-hidden="true">↗</span>
            </footer>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-frontpage">
        <p>数据正在准备中。运行 <code>npm run sync</code> 生成第一期。</p>
      </div>
    )}
  </section>

  <section class="signal-map section-shell" aria-labelledby="signal-title">
    <div class="signal-map-copy">
      <span class="section-number">02</span>
      <p class="overline">SIGNAL DISTRIBUTION</p>
      <h2 id="signal-title">今天的研究流向</h2>
      <p>
        预印本负责速度，顶会负责同行评审，顶刊负责长期价值，技术报告补充工业界的一手系统经验。
      </p>
      <a class="text-link" href={withBase("about/")}>查看同步方法 <span>→</span></a>
    </div>
    <div class="topic-board">
      <div class="topic-board-head">
        <span>TOPIC INDEX</span>
        <span>{latestDate || "NO DATA"}</span>
      </div>
      <ol>
        {topics.map((topic, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{topic}</strong>
            <i style={`--size: ${Math.max(28, 100 - index * 12)}%`}></i>
            <small>
              {(latestIssue?.items ?? []).filter((item: any) => item.tags?.[0] === topic).length} 条
            </small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="recent-issues section-shell" aria-labelledby="recent-title">
    <header class="section-header">
      <div>
        <span class="section-number">03</span>
        <p class="overline">ISSUE ARCHIVE</p>
        <h2 id="recent-title">最近期号</h2>
      </div>
      <a class="text-link" href={withBase("archive/")}>全部归档 <span>→</span></a>
    </header>
    <div class="issue-list">
      {posts.slice(0, 5).map((post, index) => <IssueCard post={post} index={index} />)}
      {!posts.length && <p class="empty-note">尚无已生成的期号。</p>}
    </div>
  </section>
</BaseLayout>
